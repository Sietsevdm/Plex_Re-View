# Copy to .env (or enter these in Portainer's stack environment variables).

# Required
TAUTULLI_URL=http://192.168.1.10:8181      # how the container reaches Tautulli (include a base URL like /tautulli if you use one)
TAUTULLI_API_KEY=your-tautulli-api-key     # Tautulli > Settings > Web Interface > API key
SESSION_SECRET=change-me-to-a-long-random-string

# Optional
TZ=Europe/Amsterdam                        # used for peak hour, days and streaks
PORT=8080                                  # port on the Docker host
PLEX_URL=http://192.168.1.10:32400         # for the Data page and "added this year" (needs Plex Pass)
PLEX_TOKEN=                                # the server owner's X-Plex-Token
ADMIN_USERS=                               # extra admins: Plex usernames, comma-separated (the server owner is always admin)
